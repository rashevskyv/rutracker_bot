#!/bin/bash

# Universal checker script for RuTracker bot
# Usage:
#   ./run_checker.sh           - Run main RuTracker checker (default)
#   ./run_checker.sh rt        - Run RuTracker checker
#   ./run_checker.sh hb        - Run Homebrew updates checker
#   ./run_checker.sh swuk      - Run Switch UA updates checker
#   ./run_checker.sh digest    - Send daily digest
#   ./run_checker.sh hb-digest - Send homebrew digest
#   ./run_checker.sh swuk-digest - Send Switch UA digest
#   ./run_checker.sh eshop     - eShop Live Showcase rotation (+ Gist force-upload)

# Get project root (one level up from config/)
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_DIR"

# Export GitHub token for homebrew checker
# Load from local_settings.json or set directly
if [ -f "config/local_settings.json" ]; then
    # Try to extract GITHUB_TOKEN from local_settings.json
    GITHUB_TOKEN_FROM_FILE=$(grep -o '"GITHUB_TOKEN"[[:space:]]*:[[:space:]]*"[^"]*"' config/local_settings.json | sed 's/.*"GITHUB_TOKEN"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
    if [ -n "$GITHUB_TOKEN_FROM_FILE" ]; then
        export GITHUB_TOKEN="$GITHUB_TOKEN_FROM_FILE"
        echo "DEBUG: Loaded GITHUB_TOKEN from local_settings.json (${#GITHUB_TOKEN} chars)"
    fi
fi

# Fallback: set token directly if not found in local_settings.json
if [ -z "$GITHUB_TOKEN" ]; then
    export GITHUB_TOKEN="YOUR_GITHUB_TOKEN_HERE"
    echo "DEBUG: Using hardcoded GITHUB_TOKEN (${#GITHUB_TOKEN} chars)"
fi

# Verify token is set
if [ -n "$GITHUB_TOKEN" ]; then
    echo "DEBUG: GITHUB_TOKEN is exported: ${GITHUB_TOKEN:0:10}...${GITHUB_TOKEN: -5}"
else
    echo "ERROR: GITHUB_TOKEN is not set!"
fi

# Activate virtual environment if exists
if [ -d "venv" ]; then
    source venv/bin/activate
elif [ -d ".venv" ]; then
    source .venv/bin/activate
fi

# Parse command
COMMAND="${1:-rt}"

# Digest/rt/hb must NOT download/upload Live Showcase state — that races with eshop
# and used to restore stale 20-card Gist over a fresh local 30-card showcase.
GIST_EXCLUDE_ESHOP="--exclude-eshop-state"

# Download state from Gist for operational commands
case "$COMMAND" in
    rt|rutracker|hb|homebrew|digest|daily-digest|hb-digest|homebrew-digest|swuk|switch-ua|swuk-digest|switch-ua-digest|custom|custom-releases|all)
        echo "=== Downloading state from Gist (excluding eShop Live Showcase) ==="
        python sync_gist_state.py download $GIST_EXCLUDE_ESHOP
        ;;
    eshop|eshop-deals|deals)
        echo "=== Downloading eShop Live Showcase state from Gist ==="
        python sync_gist_state.py download eshop_active_showcase.json eshop_posted_deals.json last_eshop_deals_run.json
        ;;
esac

# Execute the actual command
case "$COMMAND" in
    rt|rutracker)
        echo "=== Running RuTracker checker ==="
        python main.py
        ;;

    hb|homebrew)
        echo "=== Running Homebrew updates checker ==="
        python collect_homebrew_updates.py
        ;;

    custom|custom-releases)
        echo "=== Running Custom Switch Repositories Collector ==="
        python collect_custom_releases.py
        ;;

    digest|daily-digest)
        echo "=== Sending daily digest ==="
        python send_daily_digest.py
        ;;

    hb-digest|homebrew-digest)
        echo "=== Sending homebrew digest ==="
        python send_homebrew_digest.py
        ;;

    swuk|switch-ua)
        echo "=== Running Switch UA updates checker ==="
        python collect_swuk_updates.py
        ;;

    swuk-digest|switch-ua-digest)
        echo "=== Sending Switch UA digest ==="
        python send_swuk_digest.py
        ;;

    eshop|eshop-deals|deals)
        echo "=== Running eShop Live Showcase rotation ==="
        python send_eshop_deals.py --force
        ;;

    all)
        echo "=== Running all checkers ==="
        echo ""
        echo "--- RuTracker checker ---"
        python main.py
        echo ""
        echo "--- Homebrew checker ---"
        python collect_homebrew_updates.py
        echo ""
        echo "--- Custom Releases checker ---"
        python collect_custom_releases.py
        ;;

    help|--help|-h)
        echo "Usage: $0 [COMMAND]"
        echo ""
        echo "Commands:"
        echo "  rt, rutracker       Run RuTracker checker (default)"
        echo "  hb, homebrew        Run Homebrew updates checker"
        echo "  custom, custom-releases  Run Custom Switch Repositories Collector"
        echo "  swuk, switch-ua     Run Switch UA updates checker"
        echo "  digest              Send daily digest"
        echo "  hb-digest           Send homebrew digest"
        echo "  swuk-digest         Send Switch UA digest"
        echo "  eshop               eShop Live Showcase (--force) + Gist upload"
        echo "  all                 Run all checkers"
        echo "  help                Show this help message"
        echo ""
        echo "Examples:"
        echo "  $0                  # Run RuTracker checker"
        echo "  $0 hb               # Check homebrew updates"
        echo "  $0 custom           # Check custom switch releases"
        echo "  $0 hb-digest        # Send homebrew digest"
        echo "  $0 eshop            # Refresh eShop showcase"
        ;;

    *)
        echo "Error: Unknown command '$COMMAND'"
        echo "Run '$0 help' for usage information"
        exit 1
        ;;
esac

# Save exit code of the executed command
EXIT_CODE=$?

# Upload state to Gist for operational commands
case "$COMMAND" in
    rt|rutracker|hb|homebrew|digest|daily-digest|hb-digest|homebrew-digest|swuk|switch-ua|swuk-digest|switch-ua-digest|custom|custom-releases|all)
        echo "=== Uploading state to Gist (excluding eShop Live Showcase) ==="
        python sync_gist_state.py upload $GIST_EXCLUDE_ESHOP
        ;;
    eshop|eshop-deals|deals)
        # send_eshop_deals.py already force-uploads showcase state; keep an explicit
        # upload here as a safety net if the Python-side upload failed.
        echo "=== Ensuring eShop Live Showcase state is on Gist ==="
        python sync_gist_state.py upload --force eshop_active_showcase.json eshop_posted_deals.json last_eshop_deals_run.json
        ;;
esac

exit $EXIT_CODE
